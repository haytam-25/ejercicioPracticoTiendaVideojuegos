{
  "info": {
    "name": "Tienda · examen UT5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ejemplo · ping",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/videojuegos/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "videojuegos",
            "ping"
          ]
        },
        "description": "Si responde 200, el proyecto arranca."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Ejemplo · listar estudios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/estudios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "estudios"
          ]
        },
        "description": "Tus 8 peticiones van debajo de estas dos, sin carpetas."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"content.length = 4\", function () { pm.expect(pm.response.json().content.length).to.eql(4); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}